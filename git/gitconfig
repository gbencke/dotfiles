[user]
	email = gbencke@benckesoftware.com.br
	name = Guilherme Bencke
[push]
	default = simple
	autoSetupRemote = true
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[core]
	pager = delta
[pager]
	diff = delta
[interactive]
	diffFilter = delta --color-only --features=interactive
[diff]
	tool = difftastic
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft \"$LOCAL\" \"$REMOTE\"
[delta]
	paging = always
	navigate = true
